            "body": {
              "mode": "raw",
              "raw": "{\n  \"genre\": \"Thriller\"\n}"
            }
          }
        },
        {
          "name": "Destroy -> 200",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
