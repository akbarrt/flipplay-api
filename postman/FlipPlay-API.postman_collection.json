              "host": [
                "{{base_url}}"
              ],
              "path": [
                "media"
              ]
            }
          }
        },
        {
          "name": "Index - cari judul",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
